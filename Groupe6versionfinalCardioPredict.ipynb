import streamlit as st
import pandas as pd
import os
from sklearn.ensemble import RandomForestClassifier
from io import BytesIO
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle
from reportlab.lib.styles import getSampleStyleSheet
from reportlab.lib import colors

st.set_page_config(page_title="CardioPredict", layout="centered")

# =========================
# SESSION
# =========================
if "resultat" not in st.session_state:
    st.session_state.resultat = None

# =========================
# LOAD DATA
# =========================
@st.cache_data
def load_data():
    BASE_DIR = os.path.dirname(os.path.abspath(__file__))
    df1 = pd.read_csv(os.path.join(BASE_DIR, "coeur.csv"))
    df2 = pd.read_csv(os.path.join(BASE_DIR, "coeur_jeunes_500_excel.csv"), sep=";")
    df = pd.concat([df1, df2], ignore_index=True)
    return df.dropna(subset=["target"])

df = load_data()
X = df.drop("target", axis=1)
y = df["target"]

# =========================
# MODEL
# =========================
@st.cache_resource
def train_model():
    model = RandomForestClassifier(n_estimators=300, max_depth=8, random_state=42)
    model.fit(X, y)
    return model

model = train_model()

# =========================
# UI
# =========================
st.title("CardioPredict")

prenom = st.text_input("Prénom")
nom = st.text_input("Nom")

age = st.number_input("Âge", 0, 120, 30)
sex = st.selectbox("Sexe", ["Homme", "Femme"])
cp = st.selectbox("Douleur thoracique", ["Aucune","Moyenne","Intense"])
trestbps = st.number_input("Pression artérielle", 80, 250, 120)
chol = st.number_input("Cholestérol", 100, 400, 200)
fbs = st.selectbox("Glycémie", ["Normale","Élevée"])
restecg = st.selectbox("ECG", ["Normal","Anormal"])
thalach = st.number_input("Fréquence max", 60, 220, 120)
exang = st.selectbox("Angine effort", ["Non","Oui"])
oldpeak = st.number_input("Dépression ST", 0.0, 6.0, 1.0)
slope = st.selectbox("Pente ST", ["Montante","Descendante"])
ca = st.selectbox("Vaisseaux atteints", [0,1,2,3])
thal = st.selectbox("Thalassémie", ["Normal","Défaut important"])

# =========================
# ANALYSE
# =========================
if st.button("Analyser"):

    data = [[
        age,
        1 if sex=="Homme" else 0,
        ["Aucune","Moyenne","Intense"].index(cp),
        trestbps,
        chol,
        1 if fbs=="Élevée" else 0,
        1 if restecg=="Anormal" else 0,
        thalach,
        1 if exang=="Oui" else 0,
        oldpeak,
        1 if slope=="Descendante" else 0,
        ca,
        1 if thal=="Défaut important" else 0
    ]]

    # ================= ML =================
    proba_ml = model.predict_proba(data)[0][1]

    # ================= CLINIQUE =================
    score = 0
    if cp == "Intense": score += 2
    if ca >= 2: score += 2
    if thal == "Défaut important": score += 2
    if exang == "Oui": score += 1
    if oldpeak > 2: score += 1
    if trestbps > 160: score += 1
    if chol > 300: score += 1

    # ================= FUSION =================
    proba = proba_ml
    incertain = 0.3 < proba_ml < 0.7

    if score >= 4 and incertain:
        proba += 0.25
    elif score <= 1 and incertain:
        proba -= 0.1

    if score >= 6:
        proba = max(proba, 0.8)

    proba = max(0, min(proba, 1))

    # ================= DECISION =================
    if proba < 0.3:
        texte = "Patient sain"
        label = "RISQUE FAIBLE"
    elif proba < 0.7:
        texte = "Patient à surveiller"
        label = "RISQUE MODÉRÉ"
    else:
        texte = "Patient malade"
        label = "RISQUE ÉLEVÉ"

    st.session_state.resultat = (proba, texte, label)

    # ================= HISTORIQUE =================
    new_row = pd.DataFrame([{
        "Prenom": prenom,
        "Nom": nom,
        "Proba": round(proba,3),
        "Diagnostic": texte
    }])

    try:
        if os.path.exists("historique.csv"):
            hist = pd.read_csv("historique.csv", on_bad_lines="skip")
            hist = pd.concat([hist, new_row], ignore_index=True)
        else:
            hist = new_row

        hist.to_csv("historique.csv", index=False)
    except:
        pass

# =========================
# RESULTAT + PDF
# =========================
if st.session_state.resultat:

    proba, texte, label = st.session_state.resultat

    st.success(f"{label} ({round(proba*100,1)}%)")
    st.write(f"👉 {texte}")

    # ================= PDF =================
    buffer = BytesIO()
    doc = SimpleDocTemplate(buffer, leftMargin=40, rightMargin=40)
    styles = getSampleStyleSheet()

    contenu = []

    contenu.append(Paragraph(f"<b>Fiche patient : {prenom} {nom}</b>", styles["Title"]))
    contenu.append(Spacer(1,15))

    table_data = [
        ["Paramètre","Valeur"],
        ["Âge", age],
        ["Sexe", sex],
        ["Douleur thoracique", cp],
        ["Pression artérielle", trestbps],
        ["Cholestérol", chol],
        ["Glycémie", fbs],
        ["ECG", restecg],
        ["Fréquence max", thalach],
        ["Angine effort", exang],
        ["Dépression ST", oldpeak],
        ["Pente ST", slope],
        ["Vaisseaux atteints", ca],
        ["Thalassémie", thal]
    ]

    table = Table(table_data)
    table.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (-1,0), colors.green),
        ('TEXTCOLOR',(0,0),(-1,0),colors.white),
        ('GRID',(0,0),(-1,-1),1,colors.black)
    ]))

    contenu.append(table)
    contenu.append(Spacer(1,15))

    contenu.append(Paragraph(f"Résultat : {label} ({round(proba*100,1)}%)", styles["Heading2"]))
    contenu.append(Paragraph(texte, styles["Normal"]))
    contenu.append(Spacer(1,15))

    contenu.append(Paragraph("Explication des paramètres :", styles["Heading3"]))

    explications = {
        "Âge": "Facteur de risque naturel.",
        "Sexe": "Différences de risque selon le genre.",
        "Douleur thoracique": "Indicateur clé cardiaque.",
        "Pression artérielle": "Force du sang dans les artères.",
        "Cholestérol": "Graisses dans le sang.",
        "Glycémie": "Niveau de sucre.",
        "ECG": "Activité électrique du cœur.",
        "Fréquence max": "Capacité cardiaque.",
        "Angine effort": "Douleur à l'effort.",
        "Dépression ST": "Anomalie ECG.",
        "Pente ST": "Variation ECG.",
        "Vaisseaux atteints": "Nombre d'artères bloquées.",
        "Thalassémie": "Maladie sanguine."
    }

    for k,v in explications.items():
        contenu.append(Paragraph(f"{k} : {v}", styles["Normal"]))

    contenu.append(Spacer(1,15))

    conseils = []
    if chol > 240: conseils.append("Réduire les graisses.")
    if trestbps > 140: conseils.append("Surveiller tension.")
    if ca >= 2: conseils.append("Consulter cardiologue.")

    if conseils:
        contenu.append(Paragraph("Recommandations :", styles["Heading3"]))
        for c in conseils:
            contenu.append(Paragraph(f"- {c}", styles["Normal"]))

    doc.build(contenu)
    buffer.seek(0)

    st.download_button("Télécharger PDF", buffer, "rapport_patient.pdf")

# =========================
# HISTORIQUE
# =========================
st.subheader("Historique patients")

if os.path.exists("historique.csv"):
    hist = pd.read_csv("historique.csv", on_bad_lines="skip")
    st.dataframe(hist)
